		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Restored %lld item.</string>
			<key>other</key>
			<string>Restored %lld items.</string>
		</dict>
	</dict>
	<key>Restored %lld items. %lld stayed in the Trash: the original place is taken or the item changed.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@r@ %#@s@</string>
		<key>r</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Restored %lld item.</string>
			<key>other</key>
			<string>Restored %lld items.</string>
		</dict>
		<key>s</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld stayed in the Trash: the original place is taken or the item changed.</string>
			<key>other</key>
			<string>%lld stayed in the Trash: the original place is taken or the item changed.</string>
